# Multi-stage build for Podling Worker
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build arguments for version info
ARG VERSION=dev
ARG BUILD_DATE
ARG VCS_REF

# Build the worker binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -ldflags="-s -w -X main.version=${VERSION} -X main.buildDate=${BUILD_DATE} -X main.commit=${VCS_REF}" \
    -o podling-worker \
    ./cmd/worker

# Final stage - distroless for minimal attack surface
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

# Copy binary and certs from builder
COPY --from=builder /build/podling-worker /app/podling-worker
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Expose worker port (default 8081, configurable)
EXPOSE 8081

# Labels
LABEL org.opencontainers.image.title="Podling Worker"
LABEL org.opencontainers.image.description="Podling container orchestrator - Worker agent"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.source="https://github.com/danpasecinic/podling"

# Note: Worker requires access to Docker socket, which must be mounted from host
# Example: docker run -v /var/run/docker.sock:/var/run/docker.sock podling-worker

ENTRYPOINT ["/app/podling-worker"]
CMD ["-node-id=worker-1", "-port=8081"]
